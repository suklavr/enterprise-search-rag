# Copy to .env. Leave a key empty to stay in local mode for that component.
OPENAI_API_KEY=                 # dense embeddings (text-embedding-3-small) + answers (gpt-4o-mini); empty = hash embedder + extractive answers
PINECONE_API_KEY=               # vector store; empty = local numpy index under data/index/
PINECONE_INDEX=enterprise-search
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=demo
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
CHAT_MODEL=gpt-4o-mini
RAG_MODE=auto                   # auto | local | pinecone
DOCS_API_TOKEN=                 # only for tools/crawl_docs.py (docs.cybcube.com CMS); not needed for the demo
